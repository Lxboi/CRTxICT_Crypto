# .env.example
#
# Copiez ce fichier en ".env" (jamais commité, voir .gitignore) et
# remplissez avec vos vraies valeurs. Liste EXHAUSTIVE des variables
# lues par le robot (voir config/settings.py::Settings.from_env, point
# unique de lecture des variables d'environnement) -- simplifiée depuis
# la refonte architecture crypto-only/Kraken uniquement/mono-utilisateur
# (août 2026) : plus de IBKR_*/OKX_*/BINANCE_API_*(exécution)/
# ACCOUNTS_ENCRYPTION_KEY.

# --- Telegram (notifications de trading ET messages administrateur) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Kraken (VOTRE exécution réelle -- Kraken FUTURES, PAS Spot/Marge,
# clés API séparées -- voir execution/kraken_client.py) ---
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- SoSoValue (calendrier macro, optionnel -- absent = calendrier
# macro simplement indisponible, aucun impact sur le reste du robot) ---
SOSOVALUE_API_KEY=

# --- Polygon.io (collecteur Forex/CFD, optionnel -- collectors/polygon.py
# reste disponible dans le repo pour un usage futur, mais aucun actif
# n'y est configuré par défaut depuis la simplification crypto-only,
# voir config/alerts.yaml::orchestration.assets). Laissez vide tant que
# vous ne suivez aucun actif "source: polygon". ---
POLYGON_API_KEY=

# --- Binance : AUCUNE clé nécessaire -- collectors/binance.py (collecte
# de données crypto) n'utilise que des endpoints publics, sans
# authentification. Binance n'est plus utilisé pour l'exécution (retiré
# avec IBKR/OKX, voir plan de simplification architecture). ---
